{
  "mcpServers": {
    "playwright": {
      "command": "python",
      "args": ["-m", "playwright._impl._server"]
    },
    "balance-api": {
      "command": "python",
      "args": ["balance_api_mcp.py"],
      "env": {
        "BALANCE_API_BASE_URL": "http://localhost:3001",
        "BALANCE_API_TOKEN": "dummy-token"
      }
    }
  },
  "production": {
    "balanceAPI": {
      "baseURL": "http://ocsg-test.internal.company.com:8080",
      "endpoint": "/ocsg/rest/v1/subscriber/${msisdn}/balance",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer YOUR_API_TOKEN_HERE",
        "Content-Type": "application/json"
      },
      "responseMapping": {
        "subscriptionId": "subscriptionId",
        "balance": "balance",
        "currency": "currency",
        "timestamp": "timestamp"
      }
    },
    "sicGUI": {
      "baseURL": "https://your-real-sic-gui.example.com",
      "loginPath": "/login",
      "credentials": {
        "username": "your_production_username",
        "password": "your_production_password"
      }
    }
  }
}
